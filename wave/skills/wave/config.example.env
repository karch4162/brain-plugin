# Wave config for ONE repo. Copy to <repo>/.claude/wave/config.env and commit it.
# Sourced by bash, so quote values containing spaces.

# linear | jira
WAVE_TRACKER=jira

# The agent-ready queue, in the tracker's own query language. Workers and the
# refill step read it verbatim. The agent-ready label is always the human's gate.
#   linear: WAVE_QUEUE='team SPO, state Backlog, label agent-ready, unassigned'
#   jira:   (below)
WAVE_QUEUE='project = INNOV AND labels = brain-plugin AND labels = agent-ready AND statusCategory = "To Do" AND assignee IS EMPTY ORDER BY priority DESC'

# Only for WAVE_TRACKER=jira.
WAVE_JIRA_SITE=your-site.atlassian.net

# Workflow state names a worker moves its issue through.
WAVE_STATE_START='In Progress'
WAVE_STATE_DONE='Validate'

# Where workers and walkers file follow-up issues (never with agent-ready).
WAVE_FILE_TO='Jira project INNOV, label brain-plugin'

# Optional. Defaults to origin/HEAD.
# WAVE_BASE=origin/main

# Only for WAVE_TRACKER=linear: the team `triage.sh --all` lists.
# WAVE_LINEAR_TEAM=SPO
