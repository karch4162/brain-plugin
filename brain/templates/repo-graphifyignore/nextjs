next.config.*
next-env.d.ts
Dockerfile
Dockerfile.*
entrypoint.sh
docker-compose*.yml
.env
.env.*

# --- tests and test scaffolding --------------------------------------------
# BY NAME, because *.test.* / *.spec.* does NOT match jest.setup.ts,
# jest.config.js or vitest.config.ts — that gap is how test tooling got into
# a real monorepo's graph while the pattern-based exclusions "looked complete".
test/
tests/
__tests__/
__mocks__/
e2e/
cypress/
playwright/
*.test.*
*.spec.*
jest.config.*
jest.setup.*
vitest.config.*
vitest.setup.*
playwright.config.*
setupTests.*

