    },
    {
      "name": "tray-brain",
      "path": "/c/Users/me/Projects/tray-brain",
      "remote": "git@github.com:vendsy/tray-brain.git",
      "governance": { "egress": "off", "access": "eng-only", "graphifyignore": "strict" }
    }
  ]
