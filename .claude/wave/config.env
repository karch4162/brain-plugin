# Wave config for brain-plugin (see wave/skills/wave/config.example.env).
# This is the PERSONAL plugin: its tracker is Linear, not Jira. The tray fork
# (vendsy/tray-brain-plugin) is the one that files to Jira/INNOV.

# linear | jira
WAVE_TRACKER=linear

# The agent-ready queue, in the tracker's own query language. Workers and the
# refill step read it verbatim. The agent-ready label is always the human's gate.
WAVE_QUEUE='team AI Projects, state Todo, label agent-ready, label brain-plugin, unassigned'

# Workflow state names a worker moves its issue through.
WAVE_STATE_START='In Progress'
WAVE_STATE_DONE='In Review'

# Where workers and walkers file follow-up issues (never with agent-ready).
WAVE_FILE_TO='Linear team AI Projects, label brain-plugin'

# Optional. Defaults to origin/HEAD.
# WAVE_BASE=origin/main

# Only for WAVE_TRACKER=linear: the team `triage.sh --all` lists.
WAVE_LINEAR_TEAM=AIP
